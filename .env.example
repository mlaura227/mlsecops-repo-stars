# Optional local client setting. Containers use http://mlflow:5000 internally.
MLFLOW_TRACKING_URI=http://localhost:5000

# Optional: protect /train. Set a long random value in your untracked .env.
# MLSECOPS_TRAIN_API_KEY=replace-with-a-strong-local-secret

# Optional: switch /predict to the separately validated registry after
# running src.validation_training with --auto-promote successfully.
# /train continues to use MLSECOPS_MODEL_NAME (legacy workflow).
# MLSECOPS_SERVING_MODEL_NAME=github-stars-regressor-validation-v1

# Optional: switch /train from the legacy holdout gate to the validation gate.
# Enable this alongside the validation serving registry when ready.
# MLSECOPS_TRAIN_WORKFLOW=validation
